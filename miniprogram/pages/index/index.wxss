/* index.wxss - 左侧大类树 + 右侧商品明细 */
page {
  background-color: #f5f5f5;
  height: 100%;
}

.container {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  font-family: PingFang SC, sans-serif;
  box-sizing: border-box;
}

.header {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(135deg, #1a5fb4 0%, #3584e4 100%);
  padding: 24rpx 24rpx 28rpx;
  color: #fff;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.action-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.action-btn {
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.action-btn.primary {
  background-color: #ffffff;
  color: #1a5fb4;
}

/* 主体：左树右内容 */
.main {
  flex: 1;
  min-height: 0;
  min-width: 0;
  width: 100%;
  display: flex;
  background: #f5f5f5;
  box-sizing: border-box;
}

/* 左侧大类树 */
.sidebar {
  width: 132rpx;
  flex-shrink: 0;
  background: #fff;
  border-right: 1rpx solid #eee;
}

.cat-item {
  padding: 24rpx 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  border-left: 4rpx solid transparent;
}

.cat-item.active {
  background: #e8f2fe;
  color: #1a5fb4;
  font-weight: 500;
  border-left-color: #1a5fb4;
}

.cat-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧商品明细区 */
.content {
  flex: 1;
  min-width: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  box-sizing: border-box;
}

.search-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: #fff;
  margin: 24rpx 24rpx 0;
  padding: 0 20rpx;
  height: 72rpx;
  border-radius: 12rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 26rpx;
  color: #333;
}

.search-btn {
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1a5fb4;
  font-weight: 500;
}

.subcat-scroll {
  flex-shrink: 0;
  margin: 16rpx 24rpx 0;
  white-space: nowrap;
}

.subcat-list {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-width: 100%;
}

.subcat-item {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
  background: #fff;
  border: 1rpx solid #e6e6e6;
}

.subcat-item.active {
  color: #1a5fb4;
  background: #e8f2fe;
  border-color: #1a5fb4;
  font-weight: 500;
}

.product-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}

/* 撑满滚动内容宽度，无商品时左侧白条不往里缩 */
.product-scroll-inner {
  width: 100%;
  min-width: 100%;
  box-sizing: border-box;
}

.product-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 24rpx 24rpx 48rpx;
  width: 100%;
  box-sizing: border-box;
}

.product-item {
  width: calc((100% - 28rpx) / 3);
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.product-card-cover {
  position: relative;
  width: 100%;
  height: 220rpx;
  background: #f0f0f0;
}

.product-img {
  width: 100%;
  height: 100%;
  display: block;
}

.product-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #999;
}

.product-card-body {
  padding: 12rpx 14rpx 14rpx;
  border-top: 1rpx solid #f2f2f2;
}

.product-card-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}

.product-card-price {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #e54545;
  line-height: 1.2;
}

.empty,
.loading {
  padding: 80rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.loading {
  color: #1a5fb4;
}
